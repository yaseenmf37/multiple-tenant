generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  EDITOR
  ADMIN
  SUPER_ADMIN
}

enum BookingStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum ContactStatus {
  NEW
  IN_PROGRESS
  RESPONDED
  CLOSED
  SPAM
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  password      String
  name          String?
  role          Role      @default(EDITOR)
  isActive      Boolean   @default(true)

  lastLoginAt   DateTime?
  loginAttempts Int       @default(0)
  lockedUntil   DateTime?

  invitedById   String?
  invitedBy     User?     @relation("UserInvites", fields: [invitedById], references: [id], onDelete: SetNull)
  invitedUsers  User[]    @relation("UserInvites")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sessions       Session[]
  createdInvites Invite[]  @relation("InviteCreatedBy")

  authorProfile  Author?
  createdAuthors Author[]  @relation("AuthorCreatedBy")
  bookings       Booking[] @relation("AssignedTo")
  contacts       Contact[] @relation("AssignedTo")

  @@index([email])
}

model Session {
  id          String   @id  
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  userAgent   String?
  ipAddress   String?

  expiresAt   DateTime
  createdAt   DateTime @default(now())
  lastUsedAt  DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model Invite {
  id          String    @id @default(cuid())
  email       String
  role        Role
  tokenHash   String    @unique
  expiresAt   DateTime
  acceptedAt  DateTime?
  cancelledAt DateTime?

  createdById String
  createdBy   User      @relation("InviteCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  createdAt   DateTime  @default(now())

  @@index([email])
  @@index([tokenHash])
}
model Author {
  id        String  @id @default(cuid())
  name      String
  slug      String  @unique
  email     String? @unique
  bio       String? @db.Text
  avatarUrl String?
  website   String?
  twitter   String?
  linkedin  String?
  isActive  Boolean @default(true)

  metaTitle       String?
  metaDescription String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String? @unique
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  createdById String?
  createdBy   User?   @relation("AuthorCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  images AuthorImage[]

  posts Post[]
}

model Category {
  id          String  @id @default(cuid())
  name        String  @unique
  slug        String  @unique
  description String? @db.Text
  featuredImage String?


  metaTitle       String?
  metaDescription String?

  images CategoryImage[]

  posts Post[] @relation("PostToCategory")
}

model Tag {
  id    String @id @default(cuid())
  name  String @unique
  slug  String @unique
  posts Post[] @relation("PostToTag")
}

model Post {
  id      String  @id @default(cuid())
  title   String
  slug    String  @unique
  content String  @db.Text
  excerpt String? @db.Text

  externalId String? @unique

  published   Boolean   @default(false)
  publishedAt DateTime?

  featuredImage    String?
  featuredImageAlt String?

  viewCount   Int  @default(0)
  readingTime Int?

  metaTitle       String?
  metaDescription String?
  ogImageUrl      String?
  canonicalUrl    String?
  noIndex         Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  authorId String
  author   Author @relation(fields: [authorId], references: [id], onDelete: Restrict)

  categories Category[] @relation("PostToCategory")
  tags       Tag[]      @relation("PostToTag")

  images PostImage[]

  @@index([published, publishedAt])
  @@index([authorId])
}


model Service {
  id          String  @id @default(cuid())
  name        String
  slug        String  @unique
  description String  @db.Text
  shortDesc   String?
  icon        String?
  image       String?
  price       Decimal? @db.Decimal(10, 2)
  duration    Int?   
  isActive    Boolean @default(true)
  order       Int     @default(0)

  metaTitle       String?
  metaDescription String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  bookings Booking[]
}

model Booking {
  id     String        @id @default(cuid())
  status BookingStatus @default(PENDING)


  name    String
  email   String
  phone   String?
  company String?

  scheduledAt DateTime
  duration    Int     
  notes       String?  @db.Text
  meetingUrl  String? 
  internalNotes String? @db.Text

  serviceId String
  service   Service @relation(fields: [serviceId], references: [id], onDelete: Restrict)

  assignedToId String?
  assignedTo   User?   @relation("AssignedTo", fields: [assignedToId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, scheduledAt])
  @@index([email])
}

model Contact {
  id      String        @id @default(cuid())
  status  ContactStatus @default(NEW)

  name    String
  email   String
  phone   String?
  company String?
  subject String?
  message String  @db.Text


  source    String? 
  ipAddress String?
  userAgent String?

  internalNotes String? @db.Text
  respondedAt   DateTime?

  assignedToId String?
  assignedTo   User?   @relation("AssignedTo", fields: [assignedToId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
  @@index([email])
}

model Newsletter {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String?
  isSubscribed Boolean   @default(true)
  subscribedAt DateTime  @default(now())
  unsubscribedAt DateTime?
  source       String?  
}

model WebhookIdempotencyKey {
  key         String   @id
  source      String
  resourceId  String
  createdAt   DateTime @default(now())
  @@index([createdAt])
  @@index([source])
}

enum PostImageRole {
  FEATURED
  OG
  CONTENT
}

model PostImage {
  id        String   @id @default(cuid())
  filename  String   @unique
  url       String
  mime      String
  size      Int
  role PostImageRole

  postId    String?
  post      Post?          @relation(fields: [postId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([postId, role])
  @@index([createdAt])
}

enum AuthorImageRole {
  AVATAR
}

model AuthorImage {
  id        String           @id @default(cuid())
  filename  String           @unique
  url       String
  mime      String
  size      Int
  role      AuthorImageRole

  authorId  String?
  author    Author?          @relation(fields: [authorId], references: [id], onDelete: SetNull)

  createdAt DateTime         @default(now())

  @@index([authorId])
  @@index([authorId, role])
  @@index([createdAt])
}

enum CategoryImageRole {
  FEATURED
}


model CategoryImage {
  id         String             @id @default(cuid())
  filename   String             @unique
  url        String
  mime       String
  size       Int
  role       CategoryImageRole

  categoryId String?
  category   Category?          @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  createdAt  DateTime           @default(now())

  @@index([categoryId])
  @@index([categoryId, role])
  @@index([createdAt])
}